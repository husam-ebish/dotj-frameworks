    {
      "id": "BA01-literal-truth-table",
      "actions": [
        "Create main.proj with P=base,Q=base.",
        "Conditionally assign P=tt under true And true; attempt P=bad under true And false; attempt Q=bad under false And true and false And false.",
        "Evaluate Default Project, read P/Q, ordered imports and diagnostics, unload all and dispose."
      ],
      "observe": [
        "All four conjunction truth combinations through final P/Q",
        "No import/diagnostic/task side effects"
      ],
      "nativeOutcome": {
        "status": "UNOBSERVED"
      }
    },
    {
      "id": "BA02-balanced-nesting",
      "actions": [
        "Create main.proj with P=base,Q=base.",
        "Assign P=nested under (('Alpha' == 'alpha') And (true And ('beta' == 'BETA'))).",
        "Attempt Q=bad under ((true And false) And true); read P/Q and cleanup."
      ],
      "observe": [
        "Balanced nested grouping",
        "Existing alphabetic case-insensitive equality inside conjunction"
      ],
      "nativeOutcome": {
        "status": "UNOBSERVED"
      }
    },
    {
      "id": "BA03-token-case-and-boundaries",
      "actions": [
        "Create main.proj with P=base,Q=base.",
        "Assign P=mixed under true aNd true with XML whitespace between tokens.",
        "Assign Q=quoted under ('candy' == 'CANDY') AnD ('And' == 'and'); evaluate and cleanup."
      ],
      "observe": [
        "And token ASCII case behavior",
        "Word containing and and quoted And remain scalar operands"
      ],
      "nativeOutcome": {
        "status": "UNOBSERVED"
      }
    },
    {
      "id": "BA04-lazy-right-exists",
      "actions": [
        "Create main.proj with P=base,Q=tail and explicit global EmptyPath=''.",
        "Attempt P=bad under false And Exists('$(EmptyPath)').",
        "Add Import Project=missing.props under the same condition; evaluate P/Q/imports/diagnostics and cleanup. No missing.props is created."
      ],
      "observe": [
        "False left operand skips right Exists evaluation and conditional import",
        "Native result alone does not prove no filesystem probe; combine retained native result with pinned AndExpressionNode source and a candidate-specific evaluated-empty-path refusal control"
      ],
      "nativeOutcome": {
        "status": "UNOBSERVED"
      }
    },
    {
      "id": "BA05-owner-relative-exists",
      "actions": [
        "Create main.proj importing sub/entry.props; do not create root sibling.props.",
        "Create sub/sibling.props assigning Q=sibling.",
        "In sub/entry.props assign P=present under true And Exists('sibling.props'), then import sibling.props under '$(P)' == 'present' And true.",
        "Evaluate from an unrelated private working directory; read P/Q and ordered owner/target edges; cleanup."
      ],
      "observe": [
        "Exists resolves at condition's defining file",
        "Nested import result/order uses existing bounded path behavior"
      ],
      "nativeOutcome": {
        "status": "UNOBSERVED"
      }
    },
    {
      "id": "BA06-encounter-time-properties",
      "actions": [
        "Create main.proj setting Gate=alpha; assign P=first under '$(Gate)' == 'alpha' And true.",
        "Import change.props assigning Gate=beta.",
        "Assign Q=second under '$(Gate)' == 'beta' And true; evaluate P/Q/order and cleanup."
      ],
      "observe": [
        "Atom property expansion follows encounter-time state",
        "Parsed condition shape does not cache prior expanded values"
      ],
      "nativeOutcome": {
        "status": "UNOBSERVED"
      }
    },
    {
      "id": "BA07-import-groups-and-no-task-execution",
      "actions": [
        "Create main.proj with Gate=alpha, DefaultTargets=T and InitialTargets=T.",
        "Use ImportGroup Condition=\"'$(Gate)' == 'alpha' And true\" containing a.props under true And true and absent.props under false And true; a.props sets P=one.",
        "Import b.props under true And ('$(P)' == 'one'); b.props sets Q=two.",
        "Retain inert Target T with Error and WriteLinesToFile pointing only to case-local must-not-exist.txt. Evaluate only; read P/Q/import order/diagnostics; assert marker absent and cleanup."
      ],
      "observe": [
        "Compound conditions at ImportGroup and Import sites",
        "Missing false-guarded import never loaded",
        "Evaluation does not run declared targets/tasks"
      ],
      "nativeOutcome": {
        "status": "UNOBSERVED"
      }
