  "findings": [
    {
      "source": "SDK Command.cs26-94/96-106",
      "finding": "Uses Process.Start then processStarted/reaper notification; starts stdout/stderr readers, waits process then readers; env mutation is per ProcessStartInfo. Verbose paths32-35/44-48 print raw args, so owned diagnostic redaction is a deliberate binding safety requirement, not upstream verbose equivalence."
    },
    {
      "source": "SDK ProcessReaper.cs13-20,28-73,75-105,126-176",
      "finding": "Windows Job kill-on-close assigned after start; failure can return null. Dispose clears kill flag on normal completion. POSIX forwards SIGTERM to target only and waits; SIGINT parent handler suppresses signal so child handles it. No universal race-free descendant guarantee follows."
    },
    {
      "source": "JDK Process.java515-538,613-674,761-808; ProcessHandle.java152-183,290-311,352-372",
      "finding": "Force termination is not synchronous completion; wait/onExit needed. Future cancellation alone does not kill. Children/descendants are asynchronous snapshots, unsuitable as complete ownership registry."
    },
    {
      "source": "JDK ProcessBuilder.java204-280,288-359,996-1008,1074-1084,1126-1151",
      "finding": "Defensive copy required; builder list is mutable. Environment starts as copied parent map and OS may add required settings. TRACE logs args; JFR ProcessStartEvent records joined command. Wrapper cannot truthfully redact OS/JDK telemetry by sanitizing its own logs."
    },
    {
      "source": "Runtime Process.cs1468-1577; Process.Unix.cs59-140,577-605; Process.Windows.cs92-107",
      "finding": "WaitForExitAsync token cancels wait, not implicit kill. Unix tree kill stops target, enumerates children, kills and recurses. Windows calls native termination. These APIs are reference semantics, not product dependencies."
    },
    {
      "source": "Bootstrap.java67-69,102,117-145,151-166; SdkMain.java startup/main; seed proof_reader.py119/240/247/252",
      "finding": "Current seed uses in-process javac/jar; no generic product child runner. Exact7 staged/14 declared/45 class assumptions and digest chain must change when adding source. Python guards and old controlled bootstrap interruption do not prove T4."
    }
  ],
